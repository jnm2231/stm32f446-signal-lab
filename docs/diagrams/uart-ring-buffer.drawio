<mxCell id="title" value="UART RX Ring Buffer — 64 Slots, 63 Usable" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#183153;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="40" as="geometry"/></mxCell>
<mxCell id="producer" value="ISR producer&#xa;owns head" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#c99b31;fontSize=15;" vertex="1" parent="1"><mxGeometry x="65" y="120" width="170" height="70" as="geometry"/></mxCell>
<mxCell id="consumer" value="Main-loop consumer&#xa;owns tail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5ec;strokeColor=#5a9b6a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="820" y="120" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="slot0" value="0&#xa;TAIL (next read)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dff1e4;strokeColor=#65816c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="100" y="280" width="125" height="90" as="geometry"/></mxCell>
<mxCell id="slot1" value="1&#xa;queued data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dff1e4;strokeColor=#65816c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="225" y="280" width="125" height="90" as="geometry"/></mxCell>
<mxCell id="slot2" value="2&#xa;queued data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dff1e4;strokeColor=#65816c;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="280" width="125" height="90" as="geometry"/></mxCell>
<mxCell id="slot3" value="3&#xa;HEAD (next write)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff0dc;strokeColor=#c99b31;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="280" width="125" height="90" as="geometry"/></mxCell>
<mxCell id="slotdots" value="…&#xa;4–62" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="600" y="280" width="125" height="90" as="geometry"/></mxCell>
